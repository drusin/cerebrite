## Template for the REAL production Android signing keystore.
##
## Copy this file to `keystore.properties` (gitignored) in the same
## directory and fill in real values once a production keystore exists.
## Until then, a throwaway local dev keystore is used instead (see
## docs/install.md) so the release-signed build path is proven end-to-end,
## but sideload APKs built with it are NOT suitable for real distribution.
##
## Generate a real keystore with, e.g.:
##   keytool -genkeypair -v -keystore cerebrite-release.jks \
##     -alias cerebrite -keyalg RSA -keysize 2048 -validity 10000
##
## Store the resulting .jks file and its passwords somewhere durable and
## secret (a password manager / secrets vault) -- losing it means you can
## never publish an update under the same signing identity again.

storeFile=/absolute/path/to/cerebrite-release.jks
storePassword=CHANGE_ME
keyAlias=cerebrite
keyPassword=CHANGE_ME
